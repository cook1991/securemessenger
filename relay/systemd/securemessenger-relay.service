[Unit]
Description=Secure Messenger E2EE Relay
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/securemessenger-relay/dist/server.js /opt/securemessenger-relay/config.json
WorkingDirectory=/opt/securemessenger-relay
User=securemessenger
Group=securemessenger
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Scoped exception: invite-redemption state (invites.ts) is the one thing this
# process ever writes. config.json itself stays outside this path and therefore
# stays OS-enforced read-only, exactly as before.
ReadWritePaths=/opt/securemessenger-relay/state
StandardOutput=journal
StandardError=journal
# journald should only ever show lifecycle lines (start/stop/fatal) — never content.
# If port 443 proves necessary instead of 8443 (some carriers/public WiFi block
# non-80/443 outbound), uncomment these two lines instead of running the whole
# process as root:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
