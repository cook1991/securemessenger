# Real Hermes gateway coordinates (git-ignored as hermes-config.properties).
# Same reasoning as relay-config.properties.example: this repo is public, so
# nothing real goes in committed source. Copy this file to
# hermes-config.properties and fill in real values; only the compiled app needs
# them.

# Host and port of the Hermes agent gateway. Expected to hold a publicly-trusted
# TLS cert (unlike the connect-by-IP relay) -- HermesClient uses the platform
# default trust store (normal CA validation, unmodified), plus the SPKI pin(s)
# below as additional defense-in-depth on top of that, same bar as the relay's
# pinning without replacing CA trust the way the relay's self-signed cert needs.
hermes.host=relay.spritzlive.net
hermes.port=443
hermes.wsPath=/ws

# One or more comma-separated base64 SHA-256 SPKI pins for hermes.host (no
# "sha256/" prefix -- that's added in code). Include at least two: the leaf's
# current pin AND a backup (the issuing CA's pin is the usual choice) so a
# Let's Encrypt renewal doesn't silently brick this the day the leaf rotates.
# Generate with:
#   openssl x509 -in cert.pem -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | base64
hermes.pinSha256Base64=LEAF_PIN_BASE64_HERE,BACKUP_CA_PIN_BASE64_HERE

# HTTPS endpoint that exchanges a one-time pairing code for a permanent device
# token. POST {"code": "..."} -> {"token": "..."}.
hermes.pairUrl=https://relay.spritzlive.net/pair

# Self-hosted ntfy instance: subscribing to this topic's JSON stream is purely a
# "go reconnect" wake signal -- the ntfy payload itself never carries message
# content.
#
# Same auth model as this project's other ntfy use (vmapp's UnifiedPush push
# endpoints): there's no ntfy auth-file/ACL, so ntfyTopic itself IS the secret --
# treat it like a password, never log it or put it anywhere public. Generate it
# with a CSPRNG, NOT a human-chosen word like "hermes-wake" below (that's a
# placeholder only). On Linux/macOS:
#   openssl rand -hex 32
# (32 random bytes from OpenSSL's CSPRNG -- 256 bits of entropy, well above a
# UUIDv4's 122 bits). This is a one-time manual step on your end; nothing in
# the app generates this value.
#
# ntfyAuthToken is OPTIONAL and blank by default -- only set it if you later
# add an ntfy auth-file/ACL server-side (not done today). Sent as
# `Authorization: Bearer <token>` when non-blank, but requiring it client-side
# with no server-side enforcement would be cosmetic, not real protection.
hermes.ntfyHost=ntfy.example.com
hermes.ntfyTopic=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT
hermes.ntfyAuthToken=
